# Copy this file to .env and fill in your own values.
# .env is git-ignored and loaded automatically by python-dotenv.

# --- Flask -------------------------------------------------------------
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# --- Database ----------------------------------------------------------
# Required. Supabase PostgreSQL (session pooler).
# Replace [YOUR-PASSWORD] with your database password in your own .env file.
DATABASE_URL=postgresql://postgres.qzoamxjwkisdvhzjyqfx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- EPA Clean Air Markets Program Data (CAMPD) API --------------------
# Required for data retrieval. Request a free key from the CAM API Portal:
# https://www.epa.gov/power-sector/cam-api-portal
CAMPD_API_KEY=your-campd-api-key-here
