# Copy this file to .env and fill in your own values.
# .env is git-ignored and loaded automatically by python-dotenv.

# --- Flask -------------------------------------------------------------
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# --- Database ----------------------------------------------------------
# The app stores its data in the SQLite file data/epadata.db (created on the
# first page load). Set DATABASE_URL only to use a different SQLite file:
# DATABASE_URL=sqlite:////absolute/path/to/epadata.db

# The team's shared Supabase database, used to seed an empty local database
# (dashboard > "Load shared data") and by `flask data push-shared`.
# Ask the team for the connection string; replace [YOUR-PASSWORD].
SHARED_DATABASE_URL=postgresql://postgres.qzoamxjwkisdvhzjyqfx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Uploads -----------------------------------------------------------
# Optional. Maximum upload size in MB (default 32) and where original files
# and API responses are kept (default data/uploads).
# MAX_UPLOAD_MB=32
# UPLOAD_FOLDER=/absolute/path/to/uploads

# --- EPA Clean Air Markets Program Data (CAMPD) API --------------------
# Needed for data retrieval. Easiest: paste your key on the app's Data
# Retrieval or Settings page, which saves it here. Request a free key at
# https://www.epa.gov/power-sector/cam-api-portal#request-api-key
# CAMPD_API_KEY=your-campd-api-key-here
